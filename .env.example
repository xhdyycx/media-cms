# ── 时区 ────────────────────────────────────────────────
TZ=Asia/Shanghai

# ── 文件属主 ────────────────────────────────────────────
# 生成文件的 UID / GID。NAS 上设成你自己的用户 ID，
# 否则 STRM 文件和封面属主是 root，Emby 可能读不到。
PUID=0
PGID=0
UMASK=022

# ── Emby 集成 ───────────────────────────────────────────
# 容器视角下的 Emby 地址。
#   Linux 默认网桥：http://172.17.0.1:8096
#   Docker Desktop：http://host.docker.internal:8096
#   同宿主机网络：  http://127.0.0.1:8096
EMBY_HOST_PORT=http://172.17.0.1:8096

# Emby API Key：Emby 后台 → 设置 → API 密钥
EMBY_API_KEY=

# 网盘文件在宿主机上的真实路径，用逗号分隔多个。
# 留空表示只走 HTTP 代理播放（不需要本地文件）。
EMBY_LOCAL_FILE_PATH=

# ── 运行参数 ────────────────────────────────────────────
# 封面缓存策略：0 关闭 / 1 内存 / 2 磁盘 / 3 磁盘 + LRU
IMAGE_CACHE_POLICY=3

# 运行环境标识，一般不用改
RUN_ENV=online
